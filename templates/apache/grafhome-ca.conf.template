# Managed by grafhome-ca. Intended for Apache reverse proxy rollout.
SSLProxyEngine on
SSLProxyVerify require
SSLProxyVerifyDepth 2
SSLProxyCheckPeerName on
SSLProxyCheckPeerExpire on
SSLProxyCACertificateFile ${GRAFHOME_CA_PROXY_TLS_DIR}/root_ca.crt

ProxyPass        /.well-known/acme-challenge/ !
ProxyPass        / https://${GRAFHOME_CA_ORIGIN_DNS_NAME}:${GRAFHOME_CA_ORIGIN_PORT}/
ProxyPassReverse / https://${GRAFHOME_CA_ORIGIN_DNS_NAME}:${GRAFHOME_CA_ORIGIN_PORT}/
