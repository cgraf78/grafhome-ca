#!/usr/bin/env bash

set -u

address="${1:-}"
timeout="${2:-30}"
stable_seconds="${3:-2}"
ip_bin="${GRAFHOME_CA_IP_BIN:-/usr/bin/ip}"
sys_class_net="${GRAFHOME_CA_SYS_CLASS_NET:-/sys/class/net}"

if [[ -z "$address" || ! "$timeout" =~ ^[1-9][0-9]*$ ||
  ! "$stable_seconds" =~ ^[1-9][0-9]*$ ]]; then
  printf 'usage: %s ADDRESS POSITIVE_TIMEOUT POSITIVE_STABLE_SECONDS\n' "$0" >&2
  exit 2
fi

deadline=$((SECONDS + timeout))
stable_since=-1

while :; do
  address_line="$("$ip_bin" -4 -o address show to "$address/32" 2>/dev/null)"
  interface=""
  if [[ -n "$address_line" ]]; then
    read -r _index interface _rest <<<"$address_line"
    interface="${interface%%@*}"
  fi

  carrier_file="$sys_class_net/$interface/carrier"
  if [[ -n "$interface" && -r "$carrier_file" && "$(<"$carrier_file")" == 1 ]]; then
    if ((stable_since < 0)); then
      stable_since=$SECONDS
    elif ((SECONDS - stable_since >= stable_seconds)); then
      exit 0
    fi
  else
    stable_since=-1
  fi

  ((SECONDS < deadline)) || break
  sleep 1
done

printf 'grafhome-ca: CA origin %s did not become ready within %ss\n' \
  "$address" "$timeout" >&2
exit 1
