{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grafhome CA public material export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["ca_url", "root_fingerprint", "files", "host_principals"],
  "properties": {
    "ca_url": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9._-]+(:[0-9]+)?$"
    },
    "root_fingerprint": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cert",
        "root_fingerprint",
        "ssh_host_ca_key",
        "ssh_user_ca_key",
        "user_ca_keys",
        "ssh_known_hosts"
      ],
      "properties": {
        "root_cert": { "const": "root_ca.crt" },
        "root_fingerprint": { "const": "root_fingerprint" },
        "ssh_host_ca_key": { "const": "ssh_host_ca_key.pub" },
        "ssh_user_ca_key": { "const": "ssh_user_ca_key.pub" },
        "user_ca_keys": { "const": "user_ca_keys.pem" },
        "ssh_known_hosts": { "const": "ssh_known_hosts" }
      }
    },
    "host_principals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
    }
  }
}
