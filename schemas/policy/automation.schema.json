{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grafhome CA automation policy",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "source_ref", "target_ref", "purpose", "auth_model", "notes"],
    "properties": {
      "name": { "$ref": "#/definitions/name" },
      "source_ref": { "$ref": "#/definitions/ref" },
      "target_ref": { "$ref": "#/definitions/ref" },
      "purpose": { "type": "string", "minLength": 1 },
      "auth_model": { "$ref": "#/definitions/name" },
      "notes": { "type": "string" }
    }
  },
  "definitions": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
  }
}
