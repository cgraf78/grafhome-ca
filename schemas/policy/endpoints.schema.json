{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cgraf78/grafhome-ca/main/schemas/policy/endpoints.schema.json",
  "title": "endpoints policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoints"],
  "properties": {
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "dns_name", "target", "address", "port", "scheme"],
        "properties": {
          "role": {
            "enum": ["ca_api", "ca_origin"]
          },
          "dns_name": {
            "$ref": "#/definitions/dnsName"
          },
          "target": {
            "$ref": "#/definitions/name"
          },
          "address": {
            "$ref": "#/definitions/ipv4"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "scheme": {
            "enum": ["https"]
          }
        }
      },
      "minItems": 2
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "dnsName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
    }
  }
}
