{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grafhome CA endpoints policy",
  "type": "array",
  "minItems": 2,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["role", "name", "dns_name", "target", "interface", "address", "port", "scheme"],
    "properties": {
      "role": { "enum": ["ca_api", "ca_origin"] },
      "name": { "$ref": "#/definitions/name" },
      "dns_name": { "$ref": "#/definitions/dnsName" },
      "target": { "$ref": "#/definitions/name" },
      "interface": { "$ref": "#/definitions/interface" },
      "address": { "$ref": "#/definitions/ipv4" },
      "port": { "type": "string", "pattern": "^[1-9][0-9]{0,4}$" },
      "scheme": { "enum": ["https"] }
    }
  },
  "definitions": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "dnsName": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
    "interface": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
    "ipv4": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" }
  }
}
