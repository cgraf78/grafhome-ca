{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cgraf78/grafhome-ca/main/schemas/policy/host.schema.json",
  "title": "Grafhome host policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["ssh_server", "ssh_client", "principals"],
  "properties": {
    "ssh_server": { "type": "boolean" },
    "ssh_client": { "type": "boolean" },
    "principals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "user_access": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/account" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "enrollment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "allow_effectively_infinite_cert": { "type": "boolean" },
              "status": { "$ref": "#/definitions/status" }
            }
          },
          "logins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unix_account", "status"],
              "properties": {
                "unix_account": { "$ref": "#/definitions/account" },
                "status": { "$ref": "#/definitions/status" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "account": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]*[$]?$"
    },
    "status": {
      "enum": ["active", "planned", "disabled"]
    }
  }
}
