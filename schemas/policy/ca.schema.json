{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cgraf78/grafhome-ca/main/schemas/policy/ca.schema.json",
  "title": "Grafhome CA policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoints", "provisioners"],
  "properties": {
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ca_api", "ca_origin"],
      "properties": {
        "ca_api": { "$ref": "#/definitions/endpoint" },
        "ca_origin": { "$ref": "#/definitions/endpoint" }
      }
    },
    "provisioners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_bootstrap": {
          "allOf": [
            { "$ref": "#/definitions/provisioner" },
            {
              "properties": {
                "max_ttl": { "$ref": "#/definitions/ttl" }
              }
            }
          ]
        },
        "user_enrollment": {
          "allOf": [
            { "$ref": "#/definitions/provisioner" },
            {
              "properties": {
                "max_ttl": {
                  "oneOf": [{ "$ref": "#/definitions/ttl" }, { "const": "unlimited" }]
                }
              }
            }
          ]
        },
        "proxy_x509": {
          "allOf": [
            { "$ref": "#/definitions/provisioner" },
            {
              "properties": {
                "max_ttl": { "$ref": "#/definitions/ttl" }
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dns_name", "target", "address", "port"],
      "properties": {
        "dns_name": { "$ref": "#/definitions/dnsName" },
        "target": { "$ref": "#/definitions/name" },
        "address": { "$ref": "#/definitions/ipv4" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "provisioner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "default_ttl", "max_ttl", "status"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "type": { "enum": ["JWK", "ACME"] },
        "default_ttl": { "$ref": "#/definitions/ttl" },
        "max_ttl": {},
        "renewal_default_ttl": { "$ref": "#/definitions/ttl" },
        "renewal_max_ttl": { "$ref": "#/definitions/ttl" },
        "status": { "$ref": "#/definitions/status" }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "dnsName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
    },
    "ttl": {
      "type": "string",
      "pattern": "^[1-9][0-9]*[smh]$"
    },
    "status": {
      "enum": ["active", "planned", "disabled"]
    }
  }
}
