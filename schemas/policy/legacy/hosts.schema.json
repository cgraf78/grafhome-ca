{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cgraf78/grafhome-ca/main/schemas/policy/legacy/hosts.schema.json",
  "title": "hosts policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["hosts"],
  "properties": {
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "ssh_server", "ssh_client", "principals"],
        "properties": {
          "host": {
            "$ref": "#/definitions/name"
          },
          "ssh_server": {
            "type": "boolean"
          },
          "ssh_client": {
            "type": "boolean"
          },
          "principals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
