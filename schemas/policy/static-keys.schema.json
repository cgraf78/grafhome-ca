{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cgraf78/grafhome-ca/main/schemas/policy/static-keys.schema.json",
  "title": "static-keys policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["static_keys"],
  "properties": {
    "static_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "host_ref", "purpose", "class", "required_controls"],
        "properties": {
          "account": {
            "allOf": [
              {
                "$ref": "#/definitions/account"
              },
              {
                "not": {
                  "const": "root"
                }
              }
            ]
          },
          "host_ref": {
            "$ref": "#/definitions/ref"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": ["service-account", "automation", "breakglass"]
          },
          "required_controls": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "account": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]*[$]?$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
