{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grafhome CA operators policy",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["user", "host_ref", "unix_account", "privilege", "status", "notes"],
    "properties": {
      "user": { "$ref": "#/definitions/account" },
      "host_ref": { "$ref": "#/definitions/ref" },
      "unix_account": { "$ref": "#/definitions/account" },
      "privilege": { "enum": ["sudo", "user", "read-only"] },
      "status": { "enum": ["active", "planned", "disabled"] },
      "notes": { "type": "string" }
    }
  },
  "definitions": {
    "account": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*[$]?$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
  }
}
