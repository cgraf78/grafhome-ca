{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grafhome CA lifecycle plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "summary", "steps"],
  "properties": {
    "operation": {
      "enum": [
        "init-ca",
        "host-bootstrap",
        "host-renew",
        "host-renew-all",
        "backup-ca",
        "verify-live",
        "proxy-cert",
        "create-host-token",
        "enroll-host",
        "create-user-token",
        "enroll-user",
        "ssh-ensure",
        "add-host",
        "add-user"
      ]
    },
    "summary": { "$ref": "#/definitions/nonEmptyString" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "hosts", "commands", "files", "manual"],
      "properties": {
        "id": {
          "enum": [
            "render",
            "initialize-smallstep-state",
            "review-secrets",
            "export-public-material",
            "activate-service",
            "backup-ca-state",
            "restore-test-backup",
            "install-client",
            "bootstrap-trust",
            "install-rendered-files",
            "renew-host-cert",
            "proxy-cert",
            "verify-ca-api",
            "verify-ssh",
            "verify-proxy-tls",
            "edit-policy",
            "bootstrap-host",
            "create-host-token",
            "consume-host-token",
            "create-user-token",
            "consume-user-token",
            "create-user-provisioner-key",
            "authorize-user-provisioner",
            "ensure-user-cert"
          ]
        },
        "summary": { "$ref": "#/definitions/nonEmptyString" },
        "hosts": {
          "type": "array",
          "items": { "$ref": "#/definitions/hostName" },
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "manual": { "type": "boolean" }
      }
    },
    "hostName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "nonEmptyString": { "type": "string", "minLength": 1 }
  }
}
