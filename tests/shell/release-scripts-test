#!/usr/bin/env bash
set -euo pipefail

# grafhome-ca-specific release coverage.
#
# The release scripts themselves are vendored from cgraf78/actions and covered
# by that repo's test/release-scripts-test: identity resolution, packaging,
# smoke validation, and local tag cutting all live there. Re-asserting them here
# would recreate the triplicated coverage this consolidation removed.
#
# What stays is what only this repo can know: that release.conf declares the
# payload grafhome-ca ships, that no secret-bearing tree is shipped by accident,
# and that the smoke hook works.

repo_root=$(git rev-parse --show-toplevel)

fail() {
  printf 'release-scripts-test: %s\n' "$*" >&2
  exit 1
}

# shellcheck source=../../scripts/release.conf
. "$repo_root/scripts/release.conf"

[[ "$RELEASE_ENV_PREFIX" == GRAFHOME_CA ]] ||
  fail "unexpected env prefix: $RELEASE_ENV_PREFIX"
[[ "$RELEASE_ASSET_NAME" == grafhome-ca ]] ||
  fail "unexpected asset name: $RELEASE_ASSET_NAME"

# This project ships a bin/ layout. Publishing the binary at the archive root
# would silently break every installer that expects bin/grafhome-ca.
[[ "$RELEASE_BINARY_DEST" == bin/grafhome-ca ]] ||
  fail "unexpected binary destination: $RELEASE_BINARY_DEST"
[[ "$RELEASE_STANDALONE_INSTALLER" == true ]] ||
  fail "release config must opt into the generated standalone installer"

for entry in "${RELEASE_PAYLOAD_FILES[@]}"; do
  [[ -f "$repo_root/$entry" ]] || fail "declared payload file is missing: $entry"
done

# The runtime assets installers depend on. `completions` and `man` are declared
# but not generated yet, so they are deliberately absent from this list.
for required in schemas templates examples docs; do
  found=0
  for entry in "${RELEASE_PAYLOAD_DIRS[@]}"; do
    [[ "$entry" == "$required" ]] && found=1
  done
  [[ "$found" == 1 ]] || fail "release.conf must ship the $required tree"
  [[ -d "$repo_root/$required" ]] || fail "$required tree is missing from the checkout"
done

# This repo issues certificates. Payload directories are copied wholesale, so a
# tree that could carry keys or issued material must never be declared.
for forbidden in state secrets private keys ca out target; do
  for entry in "${RELEASE_PAYLOAD_DIRS[@]}"; do
    [[ "$entry" == "$forbidden" ]] &&
      fail "release.conf must not ship the $forbidden tree"
  done
done

# Same risk one level down: anything key-shaped inside a declared tree would be
# packaged into a public archive.
#
# This walks the filesystem rather than the git index on purpose. Packaging
# copies each tree wholesale with `cp -R`, so an untracked file is published
# just like a tracked one, and scanning only tracked paths would miss exactly
# the case that matters.
scan_dirs=()
for entry in "${RELEASE_PAYLOAD_DIRS[@]}"; do
  [[ -d "$repo_root/$entry" ]] && scan_dirs+=("$repo_root/$entry")
done

if [[ "${#scan_dirs[@]}" -gt 0 ]]; then
  while IFS= read -r candidate; do
    case "$candidate" in
      *.key | *.pem | *_key | *.p12 | *.pfx | *id_ed25519 | *id_rsa)
        fail "key-shaped file inside a packaged tree: ${candidate#"$repo_root/"}"
        ;;
    esac
  done < <(find "${scan_dirs[@]}" -type f)
fi

# --- Smoke hook -------------------------------------------------------------

# shellcheck source=../../scripts/release-smoke-hook.sh
. "$repo_root/scripts/release-smoke-hook.sh"

declare -F release_smoke_check >/dev/null ||
  fail "release-smoke-hook.sh must define release_smoke_check"

# The hook must exercise the bin/ layout, and a failing binary must fail smoke.
hook_fake=$(mktemp -d)
trap 'rm -rf "$hook_fake"' EXIT
mkdir -p "$hook_fake/bin"
printf '#!/usr/bin/env bash\nexit 0\n' >"$hook_fake/bin/grafhome-ca"
chmod +x "$hook_fake/bin/grafhome-ca"
release_smoke_check "$hook_fake" linux-x86_64-musl >/dev/null ||
  fail "smoke hook rejected a working binary"

printf '#!/usr/bin/env bash\nexit 4\n' >"$hook_fake/bin/grafhome-ca"
if release_smoke_check "$hook_fake" linux-x86_64-musl >/dev/null 2>&1; then
  fail "smoke hook swallowed a failing binary"
fi

# --- Workflow contract ------------------------------------------------------

release_workflow=$(<"$repo_root/.github/workflows/release.yml")
[[ "$release_workflow" == *'tag-command: scripts/release-tag.sh'* ]] ||
  fail "release workflow must use the exact reusable tag command"
[[ "$release_workflow" != *'install-musl-tools:'* ]] ||
  fail "pure-Rust release builds must not install the host musl linker"

# Vendored copies and workflow action refs are only equivalent to a single
# source while CI enforces both from the repository's canonical lock file.
ci_workflow=$(<"$repo_root/.github/workflows/ci.yml")
[[ "$ci_workflow" == *verify-consumer-sync* ]] ||
  fail "ci workflow must verify the actions lock and vendored release scripts"
cargo_msrv=$(sed -n 's/^rust-version = "\([^"]*\)"$/\1/p' "$repo_root/Cargo.toml")
[[ "$cargo_msrv" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] ||
  fail "Cargo.toml must declare one parseable rust-version"
[[ "$ci_workflow" == *"msrv-toolchain: \"$cargo_msrv\""* ]] ||
  fail "shared Rust CI toolchain must equal Cargo.toml rust-version"
[[ "$ci_workflow" != *$'\n  msrv:\n'* ]] ||
  fail "ci workflow must not duplicate the shared MSRV job"
[[ "$ci_workflow" != *'msrv-command:'* ]] ||
  fail "ci workflow must inherit the shared locked all-target MSRV command"
[[ "$ci_workflow" != *$'\n  rustsec:\n'* ]] ||
  fail "ci workflow must not duplicate the shared RustSec job"
# `ssh-key` records its optional RSA implementation in Cargo.lock even though
# grafhome-ca enables only ECDSA. Keep the unavoidable advisory exception tied
# to a PR-time reachability guard so enabling RSA cannot land under the ignore.
[[ "$ci_workflow" == *"setup-command: |"*"rsa_paths=\$(cargo tree --locked --all-features --target all -i rsa)"*"if [[ -n \"\$rsa_paths\" ]]"*"exit 1"* ]] ||
  fail "Rust CI setup must fail closed when RSA becomes reachable"
[[ "$ci_workflow" == *'audit-command: cargo audit --file Cargo.lock --ignore RUSTSEC-2023-0071'* ]] ||
  fail "RustSec must ignore only the unreachable RSA advisory"
[[ "$ci_workflow" != *'clippy-command:'* ]] ||
  fail "ci workflow must inherit the shared Clippy policy"
[[ "$ci_workflow" != *'doc-command:'* ]] ||
  fail "ci workflow must inherit the shared rustdoc policy"
[[ "$ci_workflow" != *'package-smoke-install-musl-tools:'* ]] ||
  fail "pure-Rust package smoke must not install the host musl linker"
[[ "$ci_workflow" == *"scripts/package-release.sh \"\$RUST_TARGET\" linux-x86_64-musl"* ]] ||
  fail "package smoke must reuse the target prepared by shared Rust CI"

printf 'release-scripts-test: ok\n'
